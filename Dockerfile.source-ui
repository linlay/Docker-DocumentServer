ARG DOCUMENTSERVER_BASE_IMAGE=onlyoffice/documentserver:latest
FROM ${DOCUMENTSERVER_BASE_IMAGE}

ARG ONLYOFFICE_PACKAGE_VERSION=9.4.0-129

USER root

COPY patches/onlyoffice-web-apps-9.4.0-source-ui.patch /tmp/onlyoffice-web-apps-source-ui.patch

RUN set -eux; \
    installed_version="$(dpkg-query -W -f='${Version}' onlyoffice-documentserver)"; \
    test "${installed_version}" = "${ONLYOFFICE_PACKAGE_VERSION}"; \
    patch --batch --forward -p1 \
      -d /var/www/onlyoffice/documentserver/web-apps \
      < /tmp/onlyoffice-web-apps-source-ui.patch; \
    for source_file in \
      /var/www/onlyoffice/documentserver/web-apps/apps/common/main/lib/view/Header.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/documenteditor/main/app/controller/Main.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/documenteditor/main/app/controller/Toolbar.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/documenteditor/main/app/controller/Viewport.js; do \
        gzip -n -9 -c "${source_file}" > "${source_file}.gz"; \
        chown ds:ds "${source_file}" "${source_file}.gz"; \
        chmod 0444 "${source_file}" "${source_file}.gz"; \
    done; \
    rm /tmp/onlyoffice-web-apps-source-ui.patch

LABEL org.opencontainers.image.title="ONLYOFFICE DocumentServer with source-level compact editor UI" \
      org.opencontainers.image.version="9.4.0-129-source-ui"
