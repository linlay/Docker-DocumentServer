ARG DOCUMENTSERVER_BASE_IMAGE=onlyoffice/documentserver:latest
FROM ${DOCUMENTSERVER_BASE_IMAGE}

ARG ONLYOFFICE_PACKAGE_VERSION=9.4.0-129

USER root

COPY patches/onlyoffice-web-apps-9.4.0-source-ui.patch /tmp/onlyoffice-web-apps-source-ui.patch

RUN set -eux; \
    installed_version="$(dpkg-query -W -f='${Version}' onlyoffice-documentserver)"; \
    test "${installed_version}" = "${ONLYOFFICE_PACKAGE_VERSION}"; \
    patch --batch --forward -p1 \
      -d /var/www/onlyoffice/documentserver/web-apps \
      < /tmp/onlyoffice-web-apps-source-ui.patch; \
    for source_file in \
      /var/www/onlyoffice/documentserver/web-apps/apps/common/main/lib/view/Header.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/documenteditor/main/app/controller/Main.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/documenteditor/main/app/controller/Toolbar.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/documenteditor/main/app/controller/Viewport.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/spreadsheeteditor/main/app/controller/Main.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/spreadsheeteditor/main/app/controller/Toolbar.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/spreadsheeteditor/main/app/controller/Viewport.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/presentationeditor/main/app/controller/Main.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/presentationeditor/main/app/controller/Toolbar.js \
      /var/www/onlyoffice/documentserver/web-apps/apps/presentationeditor/main/app/controller/Viewport.js; do \
        gzip -n -9 -c "${source_file}" > "${source_file}.gz"; \
        chown ds:ds "${source_file}" "${source_file}.gz"; \
        chmod 0444 "${source_file}" "${source_file}.gz"; \
    done; \
    rm /tmp/onlyoffice-web-apps-source-ui.patch

# Keep the browser plugin and the Relay in one immutable image. Serving plugin
# files from a live bind mount while the Python Relay keeps its startup-time
# contract in memory can expose two contract versions from one container.
COPY --chown=ds:ds plugins/ai-bridge/ /var/www/onlyoffice/documentserver/sdkjs-plugins/{A17E5F31-64AA-4E37-9A42-8D430814C2F6}/
COPY --chown=ds:ds plugins/ai-bridge/nginx-document-app.conf /opt/onlyoffice-copilot/nginx-document-app.conf
COPY --chown=ds:ds plugins/ai-bridge/copilot_server.py /opt/onlyoffice-copilot/copilot_server.py
COPY --chown=ds:ds plugins/ai-bridge/run-copilot.sh /opt/onlyoffice-copilot/run-copilot.sh
COPY plugins/ai-bridge/supervisor-ds-copilot.conf /etc/supervisor/conf.d/ds-copilot.conf

RUN chmod 0555 /opt/onlyoffice-copilot/run-copilot.sh; \
    chmod 0444 \
      /opt/onlyoffice-copilot/nginx-document-app.conf \
      /opt/onlyoffice-copilot/copilot_server.py \
      /etc/supervisor/conf.d/ds-copilot.conf

LABEL org.opencontainers.image.title="ONLYOFFICE DocumentServer with source-level compact editor UI" \
      org.opencontainers.image.version="9.4.0-129-source-ui"
