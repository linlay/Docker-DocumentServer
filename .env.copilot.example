# Host loopback ports. Keep them private and publish the HTTP port through the
# host reverse proxy when this demo is deployed on a server.
DOCUMENTSERVER_HTTP_PORT=8088
DOCUMENTSERVER_HTTPS_PORT=8443

# This origin is embedded in document URLs and used for callbacks. When the
# HTTP port changes, update this value to the matching public origin.
DOCUMENT_PUBLIC_ORIGIN=http://localhost:8088

# Replace these values before exposing the service.
ONLYOFFICE_JWT_SECRET=replace-with-a-long-random-secret
DOCUMENT_ADMIN_USERNAME=admin
DOCUMENT_ADMIN_PASSWORD=replace-with-a-strong-password

# The local rule-based planner works without a model. Set all three values to
# enable an OpenAI-compatible model endpoint.
COPILOT_API_BASE=https://api.openai.com/v1
COPILOT_API_KEY=
COPILOT_MODEL=

# Keep the stock ONLYOFFICE plugins disabled for the headless bridge demo.
ONLYOFFICE_DEFAULT_PLUGINS_ENABLED=false
