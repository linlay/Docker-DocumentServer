# Host loopback ports. Keep them private and publish the HTTP port through the
# host reverse proxy when this service is deployed on a server.
DOCUMENTSERVER_HTTP_PORT=8088
DOCUMENTSERVER_HTTPS_PORT=8443

# Browser-facing origin returned by the document creation API. DocumentServer
# downloads and save callbacks stay on the container loopback interface.
DOCUMENT_PUBLIC_ORIGIN=http://localhost:8088
# Parent pages allowed to embed document URLs. Arbitrary wildcard domains are
# rejected; wildcard ports are supported only for these loopback hosts.
DOCUMENT_FRAME_ANCESTORS="'self' http://localhost:* http://127.0.0.1:*"
# Maximum size accepted from an authenticated DocumentServer save callback.
DOCUMENT_MAX_SAVE_BYTES=209715200
# Optional PPTX-only template override. Leave empty to use the generic blank
# template mounted with ai-bridge.
DOCUMENT_PPTX_TEMPLATE_PATH=

# Replace these values before exposing the service.
ONLYOFFICE_JWT_SECRET=replace-with-a-long-random-secret
DOCUMENT_ADMIN_USERNAME=admin
DOCUMENT_ADMIN_PASSWORD=replace-with-a-strong-password

# The local rule-based planner works without a model. Set all three values to
# enable an OpenAI-compatible model endpoint.
COPILOT_API_BASE=https://api.openai.com/v1
COPILOT_API_KEY=
COPILOT_MODEL=

# Keep the stock ONLYOFFICE plugins disabled for the headless bridge demo.
ONLYOFFICE_DEFAULT_PLUGINS_ENABLED=false
