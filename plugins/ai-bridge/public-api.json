{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ai-bridge",
  "version": "0.1.0",
  "protocolVersion": 1,
  "pluginGuid": "asc.{A17E5F31-64AA-4E37-9A42-8D430814C2F6}",
  "transport": {
    "direct": "window.aiBridge",
    "relay": {
      "kind": "postMessage",
      "clientSource": "ai-bridge-client",
      "hostSource": "ai-bridge-relay",
      "methods": ["execute", "executeTool", "executeBatch", "save", "history", "undo", "redo", "getState"],
      "requiresExplicitClientOrigins": true,
      "wildcardOriginAllowed": false
    },
    "httpRelay": {
      "kind": "long-poll",
      "basePath": "/copilot-api/bridge",
      "localDemoOnly": true,
      "bindsWith": "ONLYOFFICE editor JWT",
      "methods": ["executeTool", "executeBatch", "save", "history", "undo", "redo", "getState"],
      "documentSelection": "JWT document.key must equal the active browser session document.key",
      "requiresOpenEditorPage": true
    },
    "broadcastChannel": false
  },
  "limits": {
    "maxToolCalls": 20,
    "maxArgumentsJsonChars": 250000,
    "maxRequestIdChars": 200,
    "maxTimeoutMs": 300000
  },
  "controls": ["save", "history", "undo", "redo"],
  "errors": [
    "NOT_READY",
    "CONNECTION_TIMEOUT",
    "TIMEOUT",
    "BRIDGE_TIMEOUT",
    "EDITOR_TOKEN_REQUIRED",
    "INVALID_EDITOR_TOKEN",
    "EDITOR_TOKEN_EXPIRED",
    "INVALID_BRIDGE_RESUME_TOKEN",
    "BRIDGE_RESUME_TOKEN_EXPIRED",
    "INVALID_RELAY_SESSION",
    "NO_ACTIVE_EDITOR",
    "MULTIPLE_ACTIVE_EDITORS",
    "SESSION_NOT_FOUND",
    "INVALID_TARGET_WINDOW",
    "INVALID_TARGET_ORIGIN",
    "INVALID_CLIENT_ID",
    "INVALID_REQUEST_ID",
    "REQUEST_ID_CONFLICT",
    "REQUEST_IN_FLIGHT",
    "INVALID_COMMAND",
    "INVALID_TOOL_CALL",
    "INVALID_ARGUMENTS",
    "ARGUMENTS_TOO_LARGE",
    "TOO_MANY_CALLS",
    "TOOL_NOT_ALLOWED",
    "CONTROL_NOT_ALLOWED",
    "METHOD_NOT_ALLOWED",
    "DOCUMENT_NOT_CONFIGURED",
    "DOCUMENT_MISMATCH",
    "EDITOR_MISMATCH",
    "PERSISTENCE_FAILED",
    "EXECUTION_FAILED",
    "INVALID_LISTENER",
    "CLIENT_DESTROYED"
