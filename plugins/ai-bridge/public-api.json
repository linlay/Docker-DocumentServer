{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ai-bridge",
  "version": "0.2.0",
  "protocolVersion": 1,
  "pluginGuid": "asc.{A17E5F31-64AA-4E37-9A42-8D430814C2F6}",
  "transport": {
    "direct": "window.aiBridge",
    "relay": {
      "kind": "postMessage",
      "clientSource": "ai-bridge-client",
      "hostSource": "ai-bridge-relay",
      "methods": ["execute", "executeTool", "executeBatch", "save", "history", "undo", "redo", "getState"],
      "requiresExplicitClientOrigins": true,
      "wildcardOriginAllowed": false
    },
    "httpRelay": {
      "kind": "long-poll",
      "basePath": "/copilot-api/bridge",
      "localDemoOnly": true,
      "bindsWith": "ONLYOFFICE editor JWT",
      "methods": ["executeTool", "executeBatch", "save", "history", "undo", "redo", "getState"],
      "documentSelection": "JWT document.key must equal the active browser session document.key",
      "requiresOpenEditorPage": true
    },
    "broadcastChannel": false
  },
  "limits": {
    "maxToolCalls": 20,
    "maxArgumentsJsonChars": 250000,
    "maxRequestIdChars": 200,
    "maxTimeoutMs": 300000
  },
  "controls": ["save", "history", "undo", "redo"],
  "errors": [
    "NOT_READY",
    "CONNECTION_TIMEOUT",
    "TIMEOUT",
    "BRIDGE_TIMEOUT",
    "EDITOR_TOKEN_REQUIRED",
    "INVALID_EDITOR_TOKEN",
    "EDITOR_TOKEN_EXPIRED",
    "INVALID_BRIDGE_RESUME_TOKEN",
    "BRIDGE_RESUME_TOKEN_EXPIRED",
    "INVALID_RELAY_SESSION",
    "NO_ACTIVE_EDITOR",
    "MULTIPLE_ACTIVE_EDITORS",
    "SESSION_NOT_FOUND",
    "INVALID_TARGET_WINDOW",
    "INVALID_TARGET_ORIGIN",
    "INVALID_CLIENT_ID",
    "INVALID_REQUEST_ID",
    "REQUEST_ID_CONFLICT",
    "REQUEST_IN_FLIGHT",
    "INVALID_COMMAND",
    "INVALID_TOOL_CALL",
    "INVALID_ARGUMENTS",
    "ARGUMENTS_TOO_LARGE",
    "TOO_MANY_CALLS",
    "TOOL_NOT_ALLOWED",
    "CONTROL_NOT_ALLOWED",
    "METHOD_NOT_ALLOWED",
    "DOCUMENT_NOT_CONFIGURED",
    "DOCUMENT_MISMATCH",
    "EDITOR_MISMATCH",
    "PERSISTENCE_FAILED",
    "EXECUTION_FAILED",
    "INVALID_LISTENER",
    "CLIENT_DESTROYED"
  ],
  "$defs": {
    "color": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" },
    "sheet": { "type": "string", "description": "工作表名称；省略时使用活动工作表" },
    "range": { "type": "string", "description": "A1 表示法，例如 A1:D10；selection 表示当前选区" },
    "gradientStop": {
      "type": "object",
      "required": ["position", "color"],
      "properties": {
        "position": { "type": "number", "minimum": 0, "maximum": 100 },
        "color": { "$ref": "#/$defs/color" }
      },
      "additionalProperties": false
    },
    "fill": {
      "oneOf": [
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "none" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "color"], "properties": { "type": { "const": "solid" }, "color": { "$ref": "#/$defs/color" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "stops"], "properties": { "type": { "const": "linearGradient" }, "stops": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/gradientStop" } }, "angleDeg": { "type": "number" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "stops"], "properties": { "type": { "const": "radialGradient" }, "stops": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/gradientStop" } } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "pattern", "backgroundColor", "foregroundColor"], "properties": { "type": { "const": "pattern" }, "pattern": { "type": "string" }, "backgroundColor": { "$ref": "#/$defs/color" }, "foregroundColor": { "$ref": "#/$defs/color" } }, "additionalProperties": false },
        { "type": "object", "required": ["raw"], "properties": { "type": { "const": "raw" }, "raw": {} }, "additionalProperties": false }
      ]
    },
    "line": {
      "type": "object",
      "properties": {
        "type": { "enum": ["solid", "none"] },
        "enabled": { "type": "boolean" },
        "widthPt": { "type": "number", "minimum": 0 },
        "color": { "$ref": "#/$defs/color" },
        "fill": { "$ref": "#/$defs/fill" },
        "raw": {}
      },
      "additionalProperties": false
    },
    "padding": {
      "type": "object",
      "properties": {
        "left": { "type": "number", "minimum": 0 },
        "top": { "type": "number", "minimum": 0 },
        "right": { "type": "number", "minimum": 0 },
        "bottom": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "chartDataLabels": {
      "type": "object",
      "properties": {
        "showSeriesName": { "type": "boolean" },
        "showCategoryName": { "type": "boolean" },
        "showValue": { "type": "boolean" },
        "showPercent": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "chartAxis": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "titleFontSize": { "type": "number" },
        "labelsFontSize": { "type": "number" },
        "normalOrder": { "type": "boolean" },
        "majorTickMark": { "type": "string" },
        "minorTickMark": { "type": "string" },
        "tickLabelPosition": { "enum": ["none", "nextTo", "low", "high"] },
        "numberFormat": { "type": "string" },
        "position": { "type": "string" }
      },
      "additionalProperties": false
    },
    "chartLegend": {
      "type": "object",
      "properties": {
        "position": { "enum": ["left", "top", "right", "bottom", "none"] },
        "fontSize": { "type": "number" },
        "fill": { "$ref": "#/$defs/fill" },
        "line": { "$ref": "#/$defs/line" }
      },
      "additionalProperties": false
    },
    "chartPointUpdate": {
      "type": "object",
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "fill": { "$ref": "#/$defs/fill" },
        "line": { "$ref": "#/$defs/line" },
        "markerFill": { "$ref": "#/$defs/fill" },
        "markerLine": { "$ref": "#/$defs/line" },
        "numberFormat": { "type": "string" },
        "allSeries": { "type": "boolean" },
        "allMarkers": { "type": "boolean" },
        "dataLabels": { "$ref": "#/$defs/chartDataLabels" }
      },
      "additionalProperties": false
    },
    "chartSeriesUpdate": {
      "type": "object",
      "required": ["index"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "values": { "type": "array", "items": { "type": "number" } },
        "valuesRange": { "type": "string" },
        "xValues": { "type": "array", "items": { "type": "number" } },
        "xValuesRange": { "type": "string" },
        "numberFormat": { "type": "string" },
        "fill": { "$ref": "#/$defs/fill" },
        "line": { "$ref": "#/$defs/line" },
        "allSeries": { "type": "boolean" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/chartPointUpdate" } }
      },
      "additionalProperties": false
    },
    "chartGridlines": {
      "type": "object",
      "properties": {
        "majorHorizontal": { "type": "object", "required": ["line"], "properties": { "line": { "$ref": "#/$defs/line" } }, "additionalProperties": false },
        "minorHorizontal": { "type": "object", "required": ["line"], "properties": { "line": { "$ref": "#/$defs/line" } }, "additionalProperties": false },
        "majorVertical": { "type": "object", "required": ["line"], "properties": { "line": { "$ref": "#/$defs/line" } }, "additionalProperties": false },
        "minorVertical": { "type": "object", "required": ["line"], "properties": { "line": { "$ref": "#/$defs/line" } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "textFormat": {
      "type": "object",
      "properties": {
        "fontSize": { "type": "number" },
        "fontFamily": { "type": "string" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" }
      }
    }
    },
    "tools": {
    "word": {
      "word_inspect": { "type": "object", "properties": { "maxChars": { "type": "number", "minimum": 500, "maximum": 60000 }, "maxParagraphs": { "type": "integer", "minimum": 0, "maximum": 500 }, "includeStructure": { "type": "boolean" }, "includeComments": { "type": "boolean" } }, "additionalProperties": false },
      "word_replace_text": { "type": "object", "required": ["search", "replace"], "properties": { "search": { "type": "string" }, "replace": { "type": "string" }, "matchCase": { "type": "boolean" } }, "additionalProperties": false },
      "word_append_paragraph": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "fontSize": { "type": "number" }, "fontFamily": { "type": "string" }, "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "underline": { "type": "boolean" }, "strikeout": { "type": "boolean" }, "color": { "$ref": "#/$defs/color" }, "highlightColor": { "$ref": "#/$defs/color" }, "align": { "enum": ["left", "center", "right", "both"] }, "spacingBefore": { "type": "number" }, "spacingAfter": { "type": "number" }, "lineSpacing": { "type": "number" }, "lineRule": { "enum": ["auto", "exact", "atLeast"] }, "styleName": { "type": "string" }, "headingLevel": { "type": "integer", "minimum": 1, "maximum": 9 }, "outlineLevel": { "type": "integer", "minimum": 0, "maximum": 8 }, "listType": { "enum": ["bullet", "numbered"] }, "listLevel": { "type": "integer", "minimum": 0, "maximum": 8 } }, "additionalProperties": false },
      "word_insert_paragraph": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "inline": { "type": "boolean" }, "fontSize": { "type": "number" }, "fontFamily": { "type": "string" }, "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "underline": { "type": "boolean" }, "strikeout": { "type": "boolean" }, "color": { "$ref": "#/$defs/color" }, "highlightColor": { "$ref": "#/$defs/color" }, "align": { "enum": ["left", "center", "right", "both"] }, "spacingBefore": { "type": "number" }, "spacingAfter": { "type": "number" }, "styleName": { "type": "string" }, "headingLevel": { "type": "integer", "minimum": 1, "maximum": 9 }, "listType": { "enum": ["bullet", "numbered"] }, "listLevel": { "type": "integer", "minimum": 0, "maximum": 8 } }, "additionalProperties": false },
      "word_format_document": { "type": "object", "properties": { "fontSize": { "type": "number" }, "fontFamily": { "type": "string" }, "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "underline": { "type": "boolean" }, "strikeout": { "type": "boolean" }, "doubleStrikeout": { "type": "boolean" }, "caps": { "type": "boolean" }, "smallCaps": { "type": "boolean" }, "color": { "$ref": "#/$defs/color" }, "highlightColor": { "$ref": "#/$defs/color" }, "characterSpacing": { "type": "number" }, "vertAlign": { "enum": ["baseline", "subscript", "superscript"] }, "align": { "enum": ["left", "center", "right", "both"] }, "spacingBefore": { "type": "number" }, "spacingAfter": { "type": "number" }, "lineSpacing": { "type": "number" }, "lineRule": { "enum": ["auto", "exact", "atLeast"] }, "firstLineIndent": { "type": "number" }, "leftIndent": { "type": "number" }, "rightIndent": { "type": "number" }, "keepLines": { "type": "boolean" }, "keepNext": { "type": "boolean" }, "widowControl": { "type": "boolean" }, "contextualSpacing": { "type": "boolean" } }, "additionalProperties": false },
