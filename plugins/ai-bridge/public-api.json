      "word_add_hyperlink": { "type": "object", "required": ["search", "url"], "properties": { "search": { "type": "string" }, "url": { "type": "string" }, "screenTip": { "type": "string" }, "bookmarkName": { "type": "string" }, "matchCase": { "type": "boolean" }, "occurrence": { "type": "integer", "minimum": 1 }, "maxMatches": { "type": "integer", "minimum": 1, "maximum": 500 } }, "additionalProperties": false },
